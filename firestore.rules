rules_version = '2';

// Reglas de seguridad de Firestore para academiadepadel.pe.
// No se aplican solas: hay que pegar este archivo completo en
// Firebase Console → Firestore Database → Reglas → Publicar.
// Explicación completa (qué cambia, qué puede romperse y cómo
// activar App Check) en README-seguridad.md.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Portal (alumno/profesor) ----------

    match /usuarios/{uid} {
      // DESVÍO del pedido original: se pidió "cada usuario lee y escribe
      // solo su propio documento", pero el portal actual necesita que un
      // profesor pueda LEER la lista de alumnos (reservas, paquetes,
      // autocompletar del árbitro) y que un alumno vea qué profesores
      // existen (selector al reservar clase). Esas pantallas ya funcionan
      // así hoy — restringir la lectura a "solo uno mismo" las rompe.
      // Se mantiene lectura abierta a cualquier usuario logueado (como
      // hoy) y escritura restringida a uno mismo (como pedías y como ya
      // estaba). Si de verdad quieres lectura 100% privada, avísame y
      // ajustamos esas pantallas antes de aplicar la regla estricta.
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /pistas/{id} {
      // "Admin por custom claim" tal como se pidió. OJO: mientras no
      // configures ese claim (ver README-seguridad.md), NADIE podrá
      // escribir en pistas — ni siquiera tú — lo que rompe "nueva pista"
      // en pistas.html y en el panel de profesor. Si prefieres mantener
      // "cualquier usuario logueado puede escribir" (como está hoy) hasta
      // tener el claim listo, dímelo y cambio esta línea.
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /reservas/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        request.resource.data.alumnoId == request.auth.uid ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'profesor'
      );
      allow update: if request.auth != null;
    }

    match /paquetes/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /esperas/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /partidos/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ---------- Árbitro ----------

    match /arbitrajes/{id} {
      // DESVÍO del pedido original: se pidió "lectura solo si hay login",
      // pero arbitrajes es la ÚNICA colección de lectura pública a
      // propósito — es lo que permite que el marcador en vivo
      // (arbitro-vivo.html) y la Multipista funcionen solo con el link,
      // sin que el espectador tenga que crear cuenta. Exigir login acá
      // rompe esa función por completo. Se mantiene lectura pública y se
      // aplica la parte que sí pedías: solo quien creó el partido puede
      // escribir/actualizar/borrarlo (antes cualquier usuario logueado
      // podía escribir en el partido de otro).
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.creadoPor == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoPor == resource.data.creadoPor;
      allow delete: if request.auth != null
        && resource.data.creadoPor == request.auth.uid;

      match /feedback/{feedbackId} {
        // Abierta a propósito, igual que arbitrajes: arbitro-entrenador.html
        // no pide login, solo el link del partido + el lado (A/B).
        allow read: if true;
        allow create: if true;
        allow delete: if true;
      }
    }

    // ---------- Catálogo de canchas ----------

    match /resenas_canchas/{resenaId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['clubId', 'nombre', 'estrellas', 'comentario', 'creadoEn'])
        && request.resource.data.clubId is string
        && request.resource.data.clubId.size() > 0
        && request.resource.data.clubId.size() <= 80
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 1
        && request.resource.data.nombre.size() <= 60
        && request.resource.data.estrellas is int
        && request.resource.data.estrellas >= 1
        && request.resource.data.estrellas <= 5
        && request.resource.data.comentario is string
        && request.resource.data.comentario.size() <= 500
        && request.resource.data.creadoEn == request.time;
      allow update: if false;
      allow delete: if false;
    }

    // ---------- Todo lo demás: denegado ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
